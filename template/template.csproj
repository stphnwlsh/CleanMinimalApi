<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>CleanMinimalApi.Template</PackageId>
    <Title>Clean Minimal API Template</Title>
    <Authors>Stephen Walsh</Authors>
    <Description>A dotnet new template for an ASP.NET Core Minimal API built with a streamlined Clean Architecture on .NET 10.</Description>
    <PackageTags>dotnet;csharp;dotnet-template;template;clean-architecture;cqrs;mediator;fluentvalidation;mapperly;entity-framework-core;docker;aspnetcore;minimal-api;rest-api;openapi</PackageTags>
    <PackageProjectUrl>https://github.com/stphnwlsh/CleanMinimalApi</PackageProjectUrl>
    <RepositoryUrl>https://github.com/stphnwlsh/CleanMinimalApi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>docs/LICENSE.md</PackageLicenseFile>
    <PackageReadmeFile>docs/NUGET.md</PackageReadmeFile>
    <PackageIcon>images/icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/stphnwlsh/CleanMinimalApi/releases</PackageReleaseNotes>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5128;NU5118</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <IsTestProject>false</IsTestProject>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <PropertyGroup>
    <TemplateExcludes>../**/bin/**;../**/obj/**;../**/TestResults/**;../**/*.user;../**/.DS_Store</TemplateExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../.template.config/**/*" Pack="true" PackagePath="content/.template.config/" />
    <None Include="../src/**/*" Exclude="$(TemplateExcludes)" Pack="true" PackagePath="content/src/" />
    <None Include="../tests/**/*" Exclude="$(TemplateExcludes)" Pack="true" PackagePath="content/tests/" />
    <None Include="../docs/RUN.md" Pack="true" PackagePath="content/docs/" />
    <None Include="../*.sln;../Directory.Build.props;../global.json;../NuGet.config;../Dockerfile;../docker-compose.yml;../icon.png;../.*ignore;../.editorconfig;../.gitattributes" Pack="true" PackagePath="content/" />
    <None Include="../icon.png" Pack="true" PackagePath="images/" />
    <None Include="../LICENSE.md" Pack="true" PackagePath="docs/" />
    <None Include="../NUGET.md" Pack="true" PackagePath="docs/" />
  </ItemGroup>

</Project>
