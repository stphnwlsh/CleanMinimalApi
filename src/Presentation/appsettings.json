{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Error"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithEnvironmentName",
      "WithMachineName"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "None"
    }
  },
  "ConnectionStrings": {
    "MovieReviews": "Data Source=movie-reviews.db"
  },
  "Authentication": {
    "Authority": "",
    "Audience": ""
  },
  "AllowedHosts": "*",
  "Database": {
    "SeedSampleData": false
  }
}
